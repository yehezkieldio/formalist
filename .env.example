# Formalist local Docker defaults
DEPLOYMENT_MODE=docker-local
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://formalist:formalist@localhost:5432/formalist
QUEUE_PROVIDER=local-redis
REDIS_URL=redis://localhost:6379

# Managed fallback example
# DEPLOYMENT_MODE=managed-fallback
# DATABASE_PROVIDER=supabase
# DATABASE_URL=
# SUPABASE_DATABASE_URL=postgres://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres
# QUEUE_PROVIDER=upstash-redis
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me

# OpenRouter is optional at boot. Chat and LLM extraction show setup-required states without it.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Formalist
CHAT_MODEL=deepseek/deepseek-v4-flash
CLASSIFIER_MODEL=deepseek/deepseek-v4-flash
EXTRACTION_MODEL=deepseek/deepseek-v4-flash
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
ENABLE_LLM_FACT_EXTRACTION=false
ENABLE_LLM_FEE_RULE_EXTRACTION=false
ENABLE_LLM_TARIFF_EXTRACTION=false
MAX_EXTRACTION_INPUT_TOKENS=8000
LLM_EXTRACTION_TIMEOUT_MS=15000

UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_MB=50
STORE_ORIGINAL_FILES=true
STORE_PAGE_IMAGES=true
STORE_DEBUG_ARTIFACTS=true

ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
