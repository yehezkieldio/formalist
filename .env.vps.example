# Formalist single-VPS, no-Docker production example.
DEPLOYMENT_MODE=self-hosted
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://formalist:replace-me@127.0.0.1:5432/formalist
QUEUE_PROVIDER=local-redis
REDIS_URL=redis://127.0.0.1:6379

# Bind the app to loopback and put nginx/Caddy in front of it.
HOST=127.0.0.1
PORT=3000

OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://formalist.example.com
OPENROUTER_APP_NAME=Formalist
OPENROUTER_PROVIDER_SORT=price
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ONLY_PROVIDERS=
OPENROUTER_IGNORE_PROVIDERS=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=false
OPENROUTER_DATA_COLLECTION=
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=
CHAT_MODEL=deepseek/deepseek-v4-flash
CLASSIFIER_MODEL=deepseek/deepseek-v4-flash
EXTRACTION_MODEL=deepseek/deepseek-v4-flash
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
ENABLE_LLM_FACT_EXTRACTION=false
ENABLE_LLM_FEE_RULE_EXTRACTION=false
ENABLE_LLM_TARIFF_EXTRACTION=false
MAX_EXTRACTION_INPUT_TOKENS=8000
LLM_EXTRACTION_TIMEOUT_MS=15000

UPLOAD_ROOT=/var/lib/formalist/uploads
MAX_UPLOAD_MB=50
STORE_ORIGINAL_FILES=true
STORE_PAGE_IMAGES=true
STORE_DEBUG_ARTIFACTS=false

ADMIN_PASSWORD=replace-me
SESSION_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=production
